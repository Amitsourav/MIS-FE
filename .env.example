# Server-only — the FastAPI backend origin. NOT NEXT_PUBLIC, so it stays private
# and the JWT can remain in an httpOnly cookie (XSS-safe). Used only by the BFF proxy.
API_URL=http://localhost:8000

# In production (Vercel sets NODE_ENV=production automatically) cookies are marked
# Secure. Point API_URL at the deployed backend (e.g. the Railway URL) on Vercel.

# Demo partner only: the CRM's AI calling (dialpad) screen. Empty = item hidden.
# NEXT_PUBLIC_ values are baked in at build time — redeploy after setting it.
NEXT_PUBLIC_CRM_AI_CALLING_URL=
